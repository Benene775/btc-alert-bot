# Copier en .env, remplir, puis : set -a && . ./.env && set +a
#
# .env est dans .gitignore : il ne doit jamais être committé.

# --- Bot Telegram d'alerte Bitcoin (bot.py) --------------------------------
# Donné par @BotFather sur Telegram (/mybots → API Token).
# Si ce jeton a déjà été publié quelque part, le révoquer d'abord : le retirer
# du code ne suffit pas, l'historique git le garde.
BTC_BOT_TOKEN=

# L'identifiant de la conversation où le bot écrit.
BTC_CHAT_ID=
