# Copier en .env, puis : set -a && . ./.env && set +a

# --- Indispensable en mode réel -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-…

# --- Mode démonstration ----------------------------------------------------
# 1 = aucun appel au modèle, contenus d'exemple. Le parcours entier reste
# cliquable, ce qui permet de faire tester la maquette sans dépenser.
# Vide = déduit automatiquement (démonstration si ANTHROPIC_API_KEY manque).
CB_DEMO_MODE=

# --- Tableau de bord du test ----------------------------------------------
# Sans jeton, /admin/metriques renvoie 404. Mettre une valeur longue et aléatoire.
CB_ADMIN_TOKEN=

# --- Le compte -------------------------------------------------------------
# Le mot de passe est haché par scrypt : rien à configurer. Le SMTP sert au
# « mot de passe oublié ». Sans lui, les codes partent dans les journaux : bon
# pour développer, inutilisable en production. Le port 587 fait du STARTTLS.
CB_SMTP_HOTE=
CB_SMTP_PORT=587
CB_SMTP_UTILISATEUR=
CB_SMTP_MOT_DE_PASSE=
CB_SMTP_EXPEDITEUR=Repère <ne-pas-repondre@mon-domaine.exemple>

# ATTENTION : renvoie le code de réinitialisation dans la réponse HTTP, donc
# n'importe qui prend n'importe quel compte. Réservé à la démonstration ; ignoré dès que
# CB_SMTP_HOTE est défini. Vide = actif seulement en mode démonstration.
CB_AUTH_CODE_EN_CLAIR=

CB_DUREE_CODE_MINUTES=10     # durée de vie d'un code de réinitialisation
CB_MAX_ESSAIS_CODE=5         # essais avant que le code soit brûlé
CB_DELAI_CODES=60            # secondes entre deux codes pour une même adresse
CB_MAX_CODES_HEURE=15        # codes par heure et par adresse
CB_MAX_CODES_HEURE_SOURCE=50 # codes par heure et par machine
CB_MAX_TENTATIVES=10         # mots de passe ratés avant blocage temporaire
CB_FENETRE_TENTATIVES=15     # durée du blocage, en minutes
CB_DUREE_JETON_JOURS=30      # durée de la connexion

# Derrière un reverse proxy (nginx, Caddy…), mettre 1 pour lire X-Forwarded-For.
# À 0, l'en-tête est ignoré : sinon n'importe qui contourne la limite par machine.
CB_PROXY_DE_CONFIANCE=0

# --- Divers ----------------------------------------------------------------
# URL publique, pour fabriquer le lien de reprise envoyé aux élèves.
CB_PUBLIC_BASE_URL=https://mon-controle-blanc.exemple
CB_DB_PATH=donnees/controle-blanc.sqlite3
# L'analyse : le seul appel qui regarde les photos du cours.
CB_MODEL=claude-sonnet-5
# Fiche, fiche ciblée, contrôle, correction : ils lisent du texte déjà
# transcrit, jamais les images.
CB_MODEL_TEXTE=claude-sonnet-5

# --- Limites d'usage (chaque appel coûte de l'argent) ----------------------
CB_QUOTA_CONTROLE_JOUR=3
CB_QUOTA_CONTROLE_SESSION=12
# L'analyse se compte en PAGES (une photo = une page), pas en envois.
CB_QUOTA_ANALYSE_JOUR=48
CB_QUOTA_FICHE_JOUR=3
CB_QUOTA_CIBLEE_JOUR=5

# Le plafond du mois, par compte : c'est celui qui tient l'abonnement. Les
# limites ci-dessus se comptent par séance, et ouvrir une séance ne coûte rien.
CB_QUOTA_ANALYSE_MOIS=96
CB_QUOTA_FICHE_MOIS=8
CB_QUOTA_CONTROLE_MOIS=8
CB_QUOTA_CIBLEE_MOIS=8
CB_MAX_PHOTOS=12
CB_RETENTION_JOURS=30

# Mettre la démonstration en ligne exprès : lève le refus de démarrage qui
# protège contre un déploiement en mode démonstration (contenus factices servis
# à de vrais élèves) et contre le code de réinitialisation renvoyé en clair.
# Ne jamais définir sur un site où de vrais élèves travaillent.
# CB_DEMO_ASSUMEE=1
